---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { buildPortfolioSchema } from "../data/seoSchema.js";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "Iker Cuadros Ruiz — Ciencia de Datos y Diseño Web | València",
    description = "Portfolio de Iker Cuadros Ruiz en València. Científico de datos, inteligencia artificial aplicada y diseño web editorial. Explora proyectos reales y demos.",
    ogImage = "/og-cover.png",
} = Astro.props;

const siteBase = Astro.site ?? new URL("https://ikercuadrosruiz.com");
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const ogImageURL = new URL(ogImage, siteBase).href;
const jsonLd = buildPortfolioSchema(siteBase.href);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Iker Cuadros Ruiz" />
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph (LinkedIn, WhatsApp, Facebook, Slack) -->
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:site_name" content="Iker Cuadros Ruiz" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Iker Cuadros Ruiz — Ciencia de Datos, IA y Diseño Web en València"
        />

        <!-- Twitter / X Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <meta name="theme-color" content="#F7F7F5" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap"
            />
        </noscript>
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(jsonLd)}
        />
        <noscript>
            <style is:inline>
                .scene { height: auto; min-height: 70vh; padding: 5rem 1.5rem; flex-direction: column; gap: 2rem; }
                .data-stage-frame, .data-stage-overlay { position: relative; opacity: 1; height: auto; padding: 2rem 1.5rem; }
                .data-stage-header, .beat, .ui-header, .ui-block, .judo-copy { position: relative; opacity: 1; transform: none; }
                .ui-bar-fill { transform: scaleX(var(--target-scale, 1)); }
                .ui-mini-bar { transform: scaleY(1); }
                .judo-frame { clip-path: none; min-height: 60vh; }
            </style>
        </noscript>
        <Analytics />
    </head>
    <body>
        <slot />
    </body>
</html>
